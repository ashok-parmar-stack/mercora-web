# ==============================================================================
# MERCORA WEB FRONTEND (.env.example)
# ==============================================================================
# Copy this file as `apps/web/.env` for Next.js web application development.
# ==============================================================================

# Application Branding
NEXT_PUBLIC_APP_NAME="Mercora Deal OS"

# Backend API URL (used by both client-side and server-side)
# Local: "http://localhost:6000/api" | Production: "https://mercora-v7cx.vercel.app/api"
NEXT_PUBLIC_API_URL="http://localhost:6000/api"

# Optional public Razorpay Key ID (the backend checkout endpoint also provides the active keyId dynamically)
# NEVER put RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET in mercora-web/.env
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_with_public_key_id

# ==============================================================================
# Cloud Bucket & Media Storage Configuration (S3 / Neon / MinIO / R2 / Local)
# ==============================================================================
# Storage Driver: 's3' (AWS S3, Neon, MinIO, Cloudflare R2) or 'local' (Development fallback)
STORAGE_DRIVER=local
STORAGE_BUCKET_NAME=assets
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STORAGE_URL=/uploads

# Standard S3 / AWS Credentials (auto-read by AWS S3 client & storage service)
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_ACCESS_KEY_ID=your_neon_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_secret_access_key
AWS_REGION=us-east-2
